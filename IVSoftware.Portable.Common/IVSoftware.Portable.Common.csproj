<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>IVSoftware.Portable.Common</Title>
		<PackageId>IVSoftware.Portable.Common</PackageId>
		<RootNamespace>IVSoftware.Portable.Common</RootNamespace>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>		
		
		<BaseVersion>1.0.1</BaseVersion>
		<VersionPrefix>$(BaseVersion)-rc</VersionPrefix>
		
		<!--netstandard2.0 does not imply a modern C# version so lock it explicitly-->
		<LangVersion>latest</LangVersion>
		
		<Description>
			Shared exception-signaling primitives and metadata attributes used throughout the IVSoftware Portable suite.
			Provides controlled Throw/Advisory pathways and caller-aware diagnostics suitable for Release-mode packages.
		</Description>
		<PackageTags>common;exceptions;diagnostics;attributes;portable;cross-platform</PackageTags>
		<RepositoryUrl>https://github.com/IVSoftware/IVSoftware.Portable.Common.git</RepositoryUrl>
		<PackageProjectUrl>https://github.com/IVSoftware/IVSoftware.Portable.Common.git</PackageProjectUrl>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Author>Thomas C. Gregor</Author>
		<Owner>IVSoftware LLC</Owner>
		<Copyright>Copyright © 2025 IVSoftware LLC</Copyright>
		<FileVersion>$(AssemblyVersion)</FileVersion>
		<Version>$(AssemblyVersion)</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageIcon>ivs.code-ape.64x64.png</PackageIcon>

		<PackageReleaseNotes>
			Initial 1.0.0-beta release
			- Provides foundational exception and advisory signaling for Release-mode packages.
			- Includes metadata attributes shared across IVSoftware NuGet packages.
			1.0.0-rc1
			- ADDED supported framework: netstandard2.0
			Stable 1.0.0
			- added missing 'event' keyword to 'BeginThrowOrAdvise'
			Beta release 1.0.1
			- Added [Policy] and [PolicyEnforcement] attributes for declarative policy metadata.
			- Introduced ThrowPolicyException extension to route policy violations through canonical Throw/Advisory pathways.
			- Enforced non-[Flags] constraint for Policy enums to preserve atomic violation semantics.
			- No breaking changes.
			Release Candidate 1.0.1
			- Fixed @throw polarity on ThrowFramework
			- Added [NotFlags] as an opt-in enforcement mechanism for enums that are intended for parsing by field name.
			- Added [Claim] attribute for linking ReadMe claims to unit tests.


		</PackageReleaseNotes>

		<AssemblyOriginatorKeyFile>D:\PFX\231201.ivs.pfx</AssemblyOriginatorKeyFile>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<SignAssembly>True</SignAssembly>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="README\**" />
		<EmbeddedResource Remove="README\**" />
		<None Remove="README\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\IVSoftware.Portable.Common\img\ivs.code-ape.64x64.png" >
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>

