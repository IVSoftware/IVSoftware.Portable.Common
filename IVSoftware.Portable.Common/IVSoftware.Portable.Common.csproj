<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>IVSoftware.Portable.Common</Title>
		<PackageId>IVSoftware.Portable.Common</PackageId>
		<RootNamespace>IVSoftware.Portable.Common</RootNamespace>
		<TargetFramework>netstandard2.0</TargetFramework>
		
		<BaseVersion>1.1.2</BaseVersion>
		<VersionPrefix>$(BaseVersion)</VersionPrefix>
		<VersionSuffix>beta</VersionSuffix>
		
		<!-- C# language version and nullable reference analysis are compiler settings,
		     independent of the target framework. Latest C# and Nullable=enable work
		     with netstandard2.0 without a separate net8.0 target or runtime dependency.
		     Individual language features can still require newer runtime support. -->
		<LangVersion>latest</LangVersion>
		
		<Description>
			Shared exception-signaling primitives and metadata attributes used throughout the IVSoftware Portable suite.
			Provides controlled Throw/Advisory pathways and caller-aware diagnostics suitable for Release-mode packages.
		</Description>
		<PackageTags>common;exceptions;diagnostics;attributes;portable;cross-platform</PackageTags>
		<RepositoryUrl>https://github.com/IVSoftware/IVSoftware.Portable.Common.git</RepositoryUrl>
		<PackageProjectUrl>https://github.com/IVSoftware/IVSoftware.Portable.Common.git</PackageProjectUrl>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Author>Thomas C. Gregor</Author>
		<Owner>IVSoftware LLC</Owner>
		<Copyright>Copyright © 2025-2026 IVSoftware LLC</Copyright>
		<FileVersion>$(AssemblyVersion)</FileVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageIcon>ivs-nuget-logo.8.png</PackageIcon>

		<PackageReleaseNotes>
			1.1.2-beta
			- Removed the redundant net8.0 asset; netstandard2.0 remains available
			  to compatible consumers, including .NET 8. No public API changes.
			- Added Barcode.NewBarcode() and Barcode.Create(DateTimeOffset) for
			  optional, infrequently generated physical-item label payloads.
			- Added BarcodeFormat.UtcTimestamp (default: yyMMdd-HHmm-AAAA) and
			  BarcodeFormat.RandomLetters (AAAAAA-AAAA-AAAA), both 16 characters.
			- Uses cryptographic randomness with unbiased letter sampling;
			  uniqueness is probabilistic, not guaranteed. Generate once and
			  persist the payload for reuse. Barcode/QR rendering is consumer-owned.
			- Added eight focused barcode tests and an opt-in direct MSTest runner.
			- Clarified ToStrongNamedFriendAssembly as a development-time annotation
			  helper. Its existing Type/unsigned-assembly diagnostics are returned
			  strings outside the Throw/Advisory stream; no helper behavior changed
			  in this release.

			1.1.x
			- Added enum-driven policy throwing with PolicyAttribute,
			  PolicyEnforcementAttribute, and ThrowPolicyException.
			- Added PolicyError to Throw so consumers can pattern match on
			  the originating enum member.
			- Added PublishedContractAttribute, NotFlagsAttribute, and
			  ClaimAttribute.
			- Added Win32Message and ToStrongNamedFriendAssembly(this object).
			- Added AppDomain TypeCache baseline functionality.
		</PackageReleaseNotes>

		<AssemblyOriginatorKeyFile>D:\PFX\231201.ivs.pfx</AssemblyOriginatorKeyFile>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<SignAssembly>True</SignAssembly>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="README\**" />
		<EmbeddedResource Remove="README\**" />
		<None Remove="README\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\IVSoftware.Portable.Common\img\ivs-nuget-logo.8.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>

